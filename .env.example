# ClinicalNote — environment configuration
# Copy this file to server/.env and fill in real values. Never commit the real file.

# --- Database ---
# Locally these can be identical. On Supabase/serverless, DATABASE_URL should
# be the pooled (pgbouncer, port 6543) connection string with
# ?pgbouncer=true&connection_limit=1, and DIRECT_URL the direct (port 5432)
# one — Prisma uses DIRECT_URL only for running migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/clinicalnote"
DIRECT_URL="postgresql://user:password@localhost:5432/clinicalnote"

# --- Sessions / cookies ---
# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret"
COOKIE_SECURE=false

# --- App / CORS ---
APP_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
PORT=4000

# --- AI mode ---
# "cloud" uses the hosted providers below (default). "local" is reserved for
# a future self-hosted Whisper/Ollama runtime and is not yet implemented —
# selecting it makes every AI feature report a clear "not configured" state.
AI_MODE=cloud

# --- Provider selection ---
# Which implementation each capability resolves to. Defaults require no paid
# subscription — both Groq and Gemini currently offer a usable free tier.
TRANSCRIPTION_PROVIDER=groq   # groq | openai
LLM_PROVIDER=gemini           # gemini | groq | openai

# --- Groq (speech-to-text, and optionally the LLM) ---
# Free tier key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# --- Gemini (structured SOAP generation) ---
# Free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (optional — not required; swap in later if desired) ---
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini

# --- File storage ---
STORE_AUDIO=false
MAX_AUDIO_UPLOAD_MB=25
STORAGE_DIR="./storage/audio"
